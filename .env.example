# Copy to .env. Defaults below match docker-compose.yml for local development.
DATABASE_URL=postgresql+asyncpg://notesapp:notesapp@localhost:5433/notesapp
REDIS_URL=redis://localhost:6379/0

# Local: MinIO via R2_ENDPOINT_URL. Staging/prod: leave R2_ENDPOINT_URL empty and set R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=notesapp-dev

OPENROUTER_API_KEY=
DAILY_SPEND_CAP_INR=500
DEV_USER_ID=00000000-0000-0000-0000-000000000001
